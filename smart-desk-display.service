[Unit]
Description=Smart Desk Display Backend
After=network.target

[Service]
WorkingDirectory=/home/pi/smart-desk-display/backend
ExecStart=/home/pi/smart-desk-display/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target
